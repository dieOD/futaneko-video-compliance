+bool mp_cmd_is_nijineko_allowed(const char *name)
+{
+    static const char *const allowed[] = {
+        "ignore",
+        "stop",
+        "cycle",
+        "seek",
+        "loadfile",
+        "playlist-clear",
+        "playlist-remove",
+        "playlist-move",
+        "playlist-next",
+        "playlist-prev",
+        "playlist-play-index",
+        "playlist-shuffle",
+        "playlist-unshuffle",
+        NULL,
+    };
+    for (int n = 0; allowed[n]; n++) {
+        if (strcmp(name, allowed[n]) == 0)
+            return true;
+    }
+    return false;
+}
